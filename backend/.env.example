# foreverart-api 环境变量（systemd EnvironmentFile 读取，key=value，不要加引号/导出符号）
# 部署位置: /home/admin/foreverart-backend/backend/.env，权限 600

# 监听地址：生产走 nginx 反代，只绑回环
HOST=127.0.0.1
# 应用端口（新加坡独立部署用 8081，与 nginx 反代对齐）
PORT=8081

# 允许跨域调用 API 的前端来源（逗号分隔）
CORS_ORIGINS=https://foreverart.github.io,http://localhost:5173

# OpenAI 兼容 LLM 上游（DeepSeek / 火山 / OpenAI 均可）
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=deepseek-chat

# 单次报告生成超时（秒）；LLM 较慢可调大
REQUEST_TIMEOUT_SEC=90
# 请求体上限（字节），默认 5MiB
MAX_BODY_BYTES=5242880

# Dashboard 管理端口令：/api/v1/admin/* 需携带 X-Admin-Password
# 留空则 admin 端点整体关闭（404）
ADMIN_PASSWORD=replace-with-strong-password

# 知识库根目录：默认使用二进制内嵌版本，调试时可指向仓库 knowledge/
# KNOWLEDGE_ROOT=/home/admin/foreverart-backend/knowledge
