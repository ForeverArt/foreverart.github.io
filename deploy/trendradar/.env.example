# TrendRadar 环境变量模板
# 部署位置: /home/admin/trendradar/.env（首次部署自动从本文件拷贝，之后不再覆盖）
# 权限建议: chmod 600 .env

# Web 服务器端口（默认 8080，nginx /report/ 反代到此端口）
WEBSERVER_PORT=8080

# AI 配置（TrendRadar 内建 AI 默认关闭，日报由 foreverart-api 生成）
# 如需开启 TrendRadar 自带的 AI 分析/翻译，填入 DeepSeek key 并取消注释
# AI_API_KEY=sk-your-deepseek-key
# AI_MODEL=deepseek/deepseek-chat
# AI_API_BASE=

# 运行配置
# 每 30 分钟抓取一次
CRON_SCHEDULE=*/30 * * * *
RUN_MODE=cron
# 启动时立即执行一次
IMMEDIATE_RUN=true
